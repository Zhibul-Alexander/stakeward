{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker per environment: it serves the built site (apps/web/dist) as static assets and the API under /api/*.
  // Always pass --env: `dev` = Solana devnet, `prod` = mainnet (scripts deploy:dev / deploy:prod).
  "name": "stakeward",
  "main": "src/index.ts",
  // Must stay <= the newest date supported by the workerd that @cloudflare/vitest-pool-workers 0.22.0 pins (2026-08-22).
  "compatibility_date": "2026-08-15",
  // @solana/kit's workerd export is its node build, which uses the Buffer global (base64, error messages in production).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Secrets (set with `wrangler secret put <NAME> --env dev|prod`, locally in .dev.vars.dev / .dev.vars.prod; never committed):
  //   RPC_URL                  required. Helius RPC URL including the API key (e.g. https://mainnet.helius-rpc.com/?api-key=...)
  //   RPC_FALLBACK_URL         optional. Second RPC URL, used for reads only when RPC_URL fails. Not listed in
  //                            secrets.required, so wrangler dev ignores it in .dev.vars (set it with `wrangler secret put`).
  //   TELEGRAM_BOT_TOKEN       required. Token of this environment's bot.
  //   TELEGRAM_WEBHOOK_SECRET  required. Value Telegram sends in X-Telegram-Bot-Api-Secret-Token.
  //   ADMIN_CHAT_ID            required. Telegram chat id for monitor and worker error reports.
  //   TELEGRAM_BOT_USERNAME    required. The bot's username without `@`.
  //   SITE_ORIGIN              required. This environment's site origin, `https://...` without a trailing slash.
  // TELEGRAM_BOT_USERNAME and SITE_ORIGIN are not secret, but they live with the secrets (in .dev.vars.<env> too):
  // `wrangler types` gives `vars` literal types and CI checks that the types are fresh, while secrets are typed `string`
  // and can change without a commit. With secrets.required the FIRST deploy of a new Worker must pass them all:
  // `wrangler deploy --env dev --secrets-file .dev.vars.dev`.
  // MONITOR_PLAN (vars): `free` or `paid`, the monitor pass preset in src/monitor/config.ts. Switch it together with the
  // Cloudflare Workers plan, then run `pnpm --filter @stakeward/worker types`.
  // Cron trigger: one monitor pass every 2 minutes per environment; dev and prod take 2 of the account's 5 free triggers.
  // Rate limits, Workers rate limiting binding, period 10 or 60 s:
  //   RPC_RATE_LIMIT       POST /api/rpc                 30 requests / 10 s per client IP (CF-Connecting-IP)
  //   LOOKUP_RATE_LIMIT    GET /api/stake-accounts       20 requests / 60 s per client IP
  //   WATCH_RATE_LIMIT     POST /api/watch               10 requests / 60 s per client IP
  //   TELEGRAM_RATE_LIMIT  POST /api/telegram/webhook    20 updates / 60 s per chat (updates come from Telegram's IPs)
  // namespace_id is any positive integer unique in the Cloudflare account; dev and prod use separate counters.

  // Top level = local-only defaults (plain `wrangler dev`, `wrangler types`). Named environments do NOT inherit
  // vars, secrets, ratelimits or d1_databases, so each env repeats them; triggers are repeated too, to be explicit.
  // The all-zero id below is never created: a deploy without --env fails.
  "vars": { "CLUSTER": "devnet", "MONITOR_PLAN": "free" },
  "secrets": {
    "required": [
      "RPC_URL",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "ADMIN_CHAT_ID",
      "TELEGRAM_BOT_USERNAME",
      "SITE_ORIGIN"
    ]
  },
  "triggers": { "crons": ["*/2 * * * *"] },
  "ratelimits": [
    { "name": "RPC_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 10 } },
    { "name": "LOOKUP_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "WATCH_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "TELEGRAM_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stakeward-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "dev": {
      "name": "stakeward-dev",
      "vars": { "CLUSTER": "devnet", "MONITOR_PLAN": "free" },
      "secrets": {
        "required": [
          "RPC_URL",
          "TELEGRAM_BOT_TOKEN",
          "TELEGRAM_WEBHOOK_SECRET",
          "ADMIN_CHAT_ID",
          "TELEGRAM_BOT_USERNAME",
          "SITE_ORIGIN"
        ]
      },
      "triggers": { "crons": ["*/2 * * * *"] },
      "ratelimits": [
        { "name": "RPC_RATE_LIMIT", "namespace_id": "1101", "simple": { "limit": 30, "period": 10 } },
        { "name": "LOOKUP_RATE_LIMIT", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
        { "name": "WATCH_RATE_LIMIT", "namespace_id": "1103", "simple": { "limit": 10, "period": 60 } },
        { "name": "TELEGRAM_RATE_LIMIT", "namespace_id": "1104", "simple": { "limit": 20, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stakeward-dev",
          // PLACEHOLDER: replace with the id printed by `wrangler d1 create stakeward-dev`.
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    },
    "prod": {
      "name": "stakeward-prod",
      "vars": { "CLUSTER": "mainnet", "MONITOR_PLAN": "free" },
      "secrets": {
        "required": [
          "RPC_URL",
          "TELEGRAM_BOT_TOKEN",
          "TELEGRAM_WEBHOOK_SECRET",
          "ADMIN_CHAT_ID",
          "TELEGRAM_BOT_USERNAME",
          "SITE_ORIGIN"
        ]
      },
      "triggers": { "crons": ["*/2 * * * *"] },
      "ratelimits": [
        { "name": "RPC_RATE_LIMIT", "namespace_id": "1201", "simple": { "limit": 30, "period": 10 } },
        { "name": "LOOKUP_RATE_LIMIT", "namespace_id": "1202", "simple": { "limit": 20, "period": 60 } },
        { "name": "WATCH_RATE_LIMIT", "namespace_id": "1203", "simple": { "limit": 10, "period": 60 } },
        { "name": "TELEGRAM_RATE_LIMIT", "namespace_id": "1204", "simple": { "limit": 20, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stakeward-prod",
          // PLACEHOLDER: replace with the id printed by `wrangler d1 create stakeward-prod`.
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ]
      // Permanent domain, once it is on Cloudflare:
      // "routes": [{ "pattern": "<domain>", "custom_domain": true }]
    }
  }
}
