{
  "name": "@stakeward/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist --env dev",
    "build:prod": "wrangler deploy --dry-run --outdir dist --env prod",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "deploy:dev": "pnpm --filter @stakeward/web build:devnet && wrangler deploy --env dev",
    "deploy:prod": "pnpm --filter @stakeward/web build:mainnet && wrangler deploy --env prod",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env prod"
  },
  "dependencies": {
    "@solana/kit": "8.4.0",
    "@stakeward/core": "workspace:*",
    "hono": "4.13.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@stakeward/web": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
